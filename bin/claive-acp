#!/usr/bin/python3
"""Expose reusable Claive workers to ACP v1 clients."""

import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
import uuid
from dataclasses import dataclass
from pathlib import Path
from typing import NamedTuple

from claivelib import cli, config, watchers


MODES = {"plan": "Read-only", "code": "Writable"}
EFFORT = "reasoning_effort"


def select(identifier, name, category, current, choices):
    return dict(id=identifier, name=name, category=category, type="select", currentValue=current,
                options=[dict(value=value, name=label) for value, label in choices.items()])


class Model(NamedTuple):
    engine: str
    provider: str | None
    model: str | None

    def entry(self):
        parts = [part for part in self if part]
        return {"modelId": "/".join(parts), "name": " · ".join(parts)}


def discover_models(launcher, args):
    if args.model:
        model = Model(args.engine or "pi", args.provider, args.model)
        return {args.model: model}, args.model

    try:
        result = subprocess.run([str(launcher), "engines", "--json"], stdin=subprocess.DEVNULL,
                                capture_output=True, text=True, timeout=20, check=True)
    except (OSError, subprocess.SubprocessError) as exc:
        raise ValueError(f"Could not discover Claive models: {exc}") from exc
    models = {}
    default = None
    for row in json.loads(result.stdout)["engines"]:
        engine = row["engine"]
        if not row["enabled"] or (args.engine and engine != args.engine):
            continue
        if not shutil.which((row.get("config") or {}).get("binary", {}).get("value") or ""):
            continue
        if engine == "pi":
            routes = [
                Model(engine, provider["provider"], model)
                for provider in row["providers"]
                if provider["enabled"] and provider["ready"] is not False
                and (not args.provider or provider["provider"] == args.provider)
                for model in provider["models"]
            ]
        elif not args.provider:
            routes = [Model(engine, None, model) for model in
                      (row["models"] if row["models"] is not None else [row["default_model"]])]
        else:
            continue
        for route in routes:
            if cli.disallowed_model(route.model) or config.model_disabled(engine, route.model):
                continue
            model_id = route.entry()["modelId"]
            models[model_id] = route
            if row["default"] and route.model == row["default_model"] and route.provider == row.get("default_provider"):
                default = model_id
    if not models:
        raise ValueError("Claive has no enabled models with an available engine. Check claive engines --json.")
    return models, default or next(iter(models))


@dataclass
class Session:
    id: str
    cwd: str
    model_id: str
    mode: str
    effort: str | None = None
    worker: str | None = None
    lane: tuple[str, str] | None = None
    native_id: str | None = None


class Prompt:
    def __init__(self, request_id, session_id, text):
        self.request_id = request_id
        self.session_id = session_id
        self.text = text
        self.tool_id = "claive-" + uuid.uuid4().hex
        self.cancelled = False
        self.process = None
        self.thread = None
        self.lock = threading.Lock()

    def cancel(self):
        with self.lock:
            self.cancelled = True
            if self.process is not None and self.process.poll() is None:
                self.process.terminate()


class Agent:
    def __init__(self, args):
        self.args = args
        self.launcher = Path(__file__).resolve().with_name("claive")
        self.catalog = None
        self.efforts = {}
        self.defaults = {}
        self.env = {key: value for key, value in os.environ.items()
                    if key not in {"CLAIVE_MISSION", "CLAIVE_NOTIFY_CMD"}}
        self.sessions = {}
        self.prompts = {}
        self.output_lock = threading.Lock()

    def send(self, **message):
        with self.output_lock:
            print(json.dumps({"jsonrpc": "2.0", **message}), flush=True)

    def update(self, session_id, **update):
        self.send(method="session/update", params={"sessionId": session_id, "update": update})

    def finish(self, prompt, stop_reason):
        self.prompts.pop(prompt.session_id, None)
        self.send(id=prompt.request_id, result={"stopReason": stop_reason})

    def error(self, request_id, code, message):
        self.send(id=request_id, error={"code": code, "message": message})

    def discover(self):
        self.catalog = discover_models(self.launcher, self.args)
        catalogs = {}
        for identifier, model in self.catalog[0].items():
            if model.engine not in catalogs:
                engine = cli.get_engine(model.engine)
                policy = config.engine_policy(model.engine)
                allowed = config.allowed_models(model.engine, config.supported_models(model.engine, engine))
                catalogs[model.engine] = engine, policy, allowed or {}
            engine, policy, allowed = catalogs[model.engine]
            disabled = policy.get("disabled_model_efforts", {}).get(model.model, [])
            self.efforts[identifier] = {effort: effort for effort in allowed.get(model.model, ())
                                        if effort not in disabled}
            self.defaults[identifier] = (self.args.reasoning_effort
                                         or policy.get("default_model_efforts", {}).get(model.model)
                                         or engine.default_effort_for(model.model))

    def options(self, session):
        models = {identifier: model.entry()["name"] for identifier, model in self.catalog[0].items()}
        options = [select("model", "Model", "model", session.model_id, models),
                   select("mode", "Worker access", "mode", session.mode, MODES)]
        if any(self.efforts.values()):
            choices = {"default": "Claive default", **self.efforts[session.model_id]}
            options.append(select(EFFORT, "Reasoning effort", "thought_level", session.effort or "default", choices))
        return options

    def model_entries(self):
        for identifier, model in self.catalog[0].items():
            efforts = self.efforts[identifier]
            metadata = {"supportsReasoningEffort": bool(efforts)}
            if efforts:
                metadata["reasoningEfforts"] = [dict(value=value, label=label) for value, label in efforts.items()]
                if self.defaults[identifier] in efforts:
                    metadata["reasoningEffort"] = self.defaults[identifier]
            yield {"modelId": identifier, "name": model.entry()["name"], "_meta": metadata}

    def change_option(self, session, name, value):
        option = next((item for item in self.options(session) if item["id"] == name), None)
        if option is None or not any(choice["value"] == value for choice in option["options"]):
            raise ValueError(f"unsupported {name}: {value}")
        if name == "model" and value != session.model_id:
            session.model_id = value
            session.effort = None
        elif name == "mode":
            session.mode = value
        elif name == EFFORT:
            session.effort = None if value == "default" else value

    def command(self, session, *arguments, text=None, timeout=None):
        return subprocess.run([str(self.launcher), *arguments], cwd=session.cwd, env=self.env,
                              input=text, capture_output=True, text=True, timeout=timeout)

    def stop_worker(self, session, cancel=False):
        worker = session.worker
        if worker is None:
            return
        result = self.command(session, "cancel" if cancel else "close", worker, timeout=10)
        if result.returncode:
            raise ValueError(self.failure(result, worker))
        path = cli.job_path(worker)
        deadline = time.monotonic() + 10
        # Ordinary claive wait also returns for a reusable worker that is idle.
        # Session shutdown needs the worker to finish closing its workspace.
        with watchers.FsWatcher([path]) as watcher:
            while cli.load(path)["status"] in cli.ACTIVE:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise ValueError(f"Claive worker {worker} did not finish shutting down")
                watcher.wait(min(0.25, remaining))
        session.worker = None

    @staticmethod
    def failure(result, worker=None):
        detail = (result.stderr.strip().splitlines() or [""])[-1]
        return detail[:500] or (f"Claive worker {worker} failed with exit code {result.returncode}."
                               if worker else "Claive launch failed.")

    def submit(self, session, text):
        model = self.catalog[0][session.model_id]
        lane = (session.model_id, session.mode)
        if session.lane and session.lane[0] != session.model_id:
            session.native_id = None
        if session.worker and cli.load(cli.job_path(session.worker))["status"] not in cli.ACTIVE:
            session.worker = None
        if session.worker and session.lane != lane:
            self.stop_worker(session)

        effort = session.effort or self.defaults[session.model_id]
        if session.worker:
            command = ["followup", session.worker, "--prompt-file", "-"]
        else:
            command = [
                "open", "--detach", "--engine", model.engine, "--no-fallback",
                "--turn-timeout", str(self.args.turn_timeout), "--workspace", session.cwd,
                "--session", f"acp-{session.id}", "--prompt-file", "-",
                "--set", '{"notifications":{"enabled":false}}',
            ]
            if session.mode == "plan":
                command.append("--read-only")
            if model.provider:
                command += ["--provider", model.provider]
            if model.model:
                command += ["--set", json.dumps({"engines": {model.engine: {"default_model": model.model}}})]
            if session.native_id:
                command += ["--session-id", session.native_id]
        if effort:
            command += ["--reasoning-effort", effort]
        submitted = self.command(session, *command, text=text)
        if submitted.returncode:
            raise ValueError(self.failure(submitted, session.worker))
        if session.worker is None:
            match = re.search(r"^Worker ([0-9a-f]{12}) \|", submitted.stdout, re.MULTILINE)
            if match is None:
                raise ValueError("Claive did not report the worker ID")
            session.worker = match[1]
            session.lane = lane

    def start(self, prompt):
        session_id = prompt.session_id
        session = self.sessions[session_id]
        status = "failed"
        text = ""
        failure = None
        try:
            self.update(session_id, sessionUpdate="tool_call_update", toolCallId=prompt.tool_id,
                        status="in_progress")
            if not prompt.cancelled:
                self.submit(session, prompt.text)
            with prompt.lock:
                if not prompt.cancelled:
                    prompt.process = subprocess.Popen(
                        [str(self.launcher), "wait", session.worker], cwd=session.cwd,
                        env=self.env, stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    )
            if prompt.process is not None:
                code = prompt.process.wait()
                if code in {0, 3} and not prompt.cancelled:
                    path = cli.job_path(session.worker)
                    state = cli.load(path, check_alive=False)
                    session.native_id = cli.worker_session_id(state)
                    text = (path / "result.txt").read_text(encoding="utf-8").strip()
                    question = (state.get("needs_parent") or {}).get("question")
                    if code == 3 and question and question not in text:
                        text = f"{text}\n\n{question}".strip()
                    status = "completed"
                elif not prompt.cancelled and code != 130:
                    failure = f"Claive worker {session.worker} failed with exit code {code}."
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            failure = f"Claive execution failed: {exc}"
        if prompt.cancelled:
            try:
                self.stop_worker(session, cancel=True)
            except (OSError, ValueError, subprocess.SubprocessError) as exc:
                print(f"claive-acp: {exc}", file=sys.stderr)
        self.update(session_id, sessionUpdate="tool_call_update", toolCallId=prompt.tool_id, status=status)
        if prompt.cancelled or (prompt.process is not None and prompt.process.returncode == 130):
            self.finish(prompt, "cancelled")
        elif failure:
            self.prompts.pop(session_id, None)
            self.error(prompt.request_id, -32603, failure)
        else:
            if text:
                self.update(session_id, sessionUpdate="agent_message_chunk",
                            content={"type": "text", "text": text})
            self.finish(prompt, "end_turn")

    def handle(self, message):
        method = message.get("method")
        request_id = message.get("id")
        params = message.get("params") or {}
        if method is None:
            prompt = next((p for p in list(self.prompts.values()) if p.tool_id == request_id), None)
            if prompt is not None and prompt.thread is None:
                outcome = (message.get("result") or {}).get("outcome") or {}
                if outcome.get("outcome") == "selected" and outcome.get("optionId") == "allow":
                    prompt.thread = threading.Thread(target=self.start, args=(prompt,))
                    prompt.thread.start()
                else:
                    self.update(prompt.session_id, sessionUpdate="tool_call_update",
                                toolCallId=prompt.tool_id, status="failed")
                    stop_reason = "cancelled" if outcome.get("outcome") == "cancelled" else "refusal"
                    self.finish(prompt, stop_reason)
            return
        if method == "initialize":
            self.send(id=request_id, result={
                "protocolVersion": 1,
                "agentInfo": {"name": "claive", "title": "Claive", "version": "0.1.0"},
                "agentCapabilities": {"loadSession": False, "sessionCapabilities": {"close": {}}},
                "authMethods": [],
            })
        elif method == "session/new":
            cwd = Path(params.get("cwd", ""))
            if not cwd.is_absolute() or not cwd.is_dir():
                raise ValueError("workspace must be an existing absolute directory")
            if self.catalog is None:
                self.discover()
            _, default = self.catalog
            session_id = uuid.uuid4().hex
            session = Session(session_id, str(cwd), default, self.args.mode)
            self.sessions[session_id] = session
            self.send(id=request_id, result={"sessionId": session_id, "models": {
                "currentModelId": default,
                "availableModels": list(self.model_entries()),
            }, "configOptions": self.options(session)})
        elif method in {"session/set_model", "session/set_mode", "session/set_config_option"}:
            session_id = params.get("sessionId")
            if session_id not in self.sessions:
                raise ValueError("unknown session")
            if session_id in self.prompts:
                raise ValueError("cannot change configuration while a prompt is in progress")
            session = self.sessions[session_id]
            if method == "session/set_config_option":
                self.change_option(session, params.get("configId"), params.get("value"))
                self.send(id=request_id, result={"configOptions": self.options(session)})
            else:
                option = "model" if method == "session/set_model" else "mode"
                self.change_option(session, option, params.get(f"{option}Id"))
                self.send(id=request_id, result={})
        elif method == "session/prompt":
            session_id = params.get("sessionId")
            if session_id not in self.sessions or session_id in self.prompts:
                raise ValueError("unknown session or prompt already in progress")
            blocks = params.get("prompt") or []
            if any(block.get("type") != "text" for block in blocks):
                raise ValueError("only text prompts are supported")
            text = "\n".join(block.get("text", "") for block in blocks)
            if not text.strip():
                raise ValueError("prompt must not be empty")
            prompt = Prompt(request_id, session_id, text)
            self.prompts[session_id] = prompt
            session = self.sessions[session_id]
            model = self.catalog[0][session.model_id]
            tool_call = {
                "toolCallId": prompt.tool_id, "kind": "execute", "status": "pending",
                "title": f"Run Claive worker · {model.entry()['name']} · {MODES[session.mode]}",
            }
            self.update(session_id, sessionUpdate="tool_call", **tool_call)
            self.send(id=prompt.tool_id, method="session/request_permission", params={
                "sessionId": session_id,
                "toolCall": tool_call,
                "options": [
                    {"optionId": "allow", "name": "Run worker", "kind": "allow_once"},
                    {"optionId": "deny", "name": "Skip worker", "kind": "reject_once"},
                ],
            })
        elif method in {"session/cancel", "session/close"}:
            session_id = params.get("sessionId")
            prompt = self.prompts.get(session_id)
            if prompt is not None:
                prompt.cancel()
                if prompt.thread is None:
                    self.finish(prompt, "cancelled")
            if method == "session/close":
                if prompt is not None and prompt.thread is not None:
                    prompt.thread.join()
                session = self.sessions.get(session_id)
                if session is not None:
                    self.stop_worker(session)
                    self.sessions.pop(session_id)
                self.send(id=request_id, result={})
        elif request_id is not None:
            self.error(request_id, -32601, f"Unsupported ACP method: {method}")

    def serve(self):
        try:
            for line in sys.stdin:
                try:
                    message = json.loads(line)
                except json.JSONDecodeError:
                    self.error(None, -32700, "Invalid JSON")
                    continue
                if not isinstance(message, dict):
                    self.error(None, -32600, "Expected a JSON-RPC object")
                    continue
                try:
                    self.handle(message)
                except (AttributeError, TypeError, ValueError) as exc:
                    self.error(message.get("id"), -32602, str(exc))
                except (OSError, subprocess.SubprocessError) as exc:
                    self.error(message.get("id"), -32603, str(exc))
        finally:
            prompts = list(self.prompts.values())
            for prompt in prompts:
                prompt.cancel()
            for prompt in prompts:
                if prompt.thread is not None:
                    prompt.thread.join()
            for session in self.sessions.values():
                try:
                    self.stop_worker(session)
                except (OSError, ValueError, subprocess.SubprocessError) as exc:
                    print(f"claive-acp: {exc}", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--engine", choices=cli.ENGINE_NAMES)
    parser.add_argument("--provider")
    parser.add_argument("--model")
    parser.add_argument("--mode", choices=MODES, default="plan", help="initial worker access")
    parser.add_argument("--reasoning-effort")
    parser.add_argument("--turn-timeout", type=float, default=1800)
    args = parser.parse_args()
    if not 0 < args.turn_timeout < float("inf"):
        parser.error("--turn-timeout must be finite and positive")
    Agent(args).serve()


if __name__ == "__main__":
    def stop(_signal, _frame):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    main()
